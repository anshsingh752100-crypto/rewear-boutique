datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          String         @default("CUSTOMER") // "CUSTOMER" | "ADMIN"
  phone         String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  wishlist      WishlistItem[]
}

model Address {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  country      String   @default("United States")
  phone        String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model Category {
  id           String    @id @default(uuid())
  name         String
  slug         String    @unique
  description  String?
  image        String?
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  products     Product[]
}

model Product {
  id               String         @id @default(uuid())
  name             String
  slug             String         @unique
  description      String
  craftsmanship    String?
  materials        String?
  origin           String?
  careInstructions String?
  price            Float
  originalPrice    Float?
  rating           Float          @default(5.0)
  reviewsCount     Int            @default(0)
  stock            Int            @default(10)
  isFeatured       Boolean        @default(false)
  isNewArrival     Boolean        @default(false)
  images           String         // JSON stringified array of URLs
  variants         String?        // JSON stringified array of variant objects {name, options}
  categoryId       String
  category         Category       @relation(fields: [categoryId], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  orderItems       OrderItem[]
  reviews          Review[]
  wishlistItems    WishlistItem[]
}

model Order {
  id                String      @id @default(uuid())
  orderNumber       String      @unique
  userId            String?
  user              User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName      String
  customerEmail     String
  customerPhone     String?
  shippingAddress   String      // JSON stringified address
  billingAddress    String?     // JSON stringified address
  paymentMethod     String      @default("COD") // "COD" | "CARD"
  paymentStatus     String      @default("PENDING") // "PAID" | "PENDING"
  status            String      @default("PROCESSING") // "PROCESSING" | "SHIPPED" | "DELIVERED" | "CANCELLED"
  subtotal          Float
  tax               Float
  shippingFee       Float       @default(0.0)
  discountAmount    Float       @default(0.0)
  total             Float
  couponCode        String?
  estimatedDelivery DateTime?
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  items             OrderItem[]
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName  String
  productImage String?
  price        Float
  quantity     Int
  variant      String?
}

model Coupon {
  id             String    @id @default(uuid())
  code           String    @unique
  discountType   String    @default("PERCENT") // "PERCENT" | "FIXED"
  discountValue  Float
  minOrderValue  Float     @default(0.0)
  maxDiscount    Float?
  usageLimit     Int?
  timesUsed      Int       @default(0)
  isActive       Boolean   @default(true)
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
}

model Review {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName   String
  rating     Int      @default(5)
  title      String?
  comment    String
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model SiteContent {
  key       String   @id
  value     String   // JSON string
  updatedAt DateTime @updatedAt
}
